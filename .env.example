# gemini-web2api .env 配置
# 优先级: 默认值 < config.json < .env文件 < 命令行参数
# 用法: python -m gemini_web2api --env-file .env.anon
#       python -m gemini_web2api --env-file .env.cookie

# ── 无鉴权实例 (.env.anon 示例) ──────────────────
PORT=8081
#COOKIE_FILE=          # 留空/不设 = 匿名 (所有模型路由到 Flash-Lite)

# ── 带cookie实例 (.env.cookie 示例) ──────────────
#PORT=8082
#COOKIE_FILE=cookie.txt
#XSRF_TOKEN=
#AUTH_USER=

# ── 通用 ────────────────────────────────────────
#HOST=0.0.0.0
#DEFAULT_MODEL=gemini-3.8-flash
#API_KEYS=sk-gemini
#PROXY=http://127.0.0.1:7890
#LOG_REQUESTS=true
#TEMPORARY_CHATS=false
#RETRY_ATTEMPTS=3
#RETRY_DELAY_SEC=2
#REQUEST_TIMEOUT_SEC=180
